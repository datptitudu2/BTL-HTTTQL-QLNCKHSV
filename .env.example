# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / Docker)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/srms_ptit?sslmode=require"

# JWT Auth
JWT_SECRET="replace-with-strong-random-secret"
JWT_EXPIRES_IN="1d"

# Backend URL & Frontend CORS
PORT=4000
APP_URL="https://your-frontend.vercel.app"
CORS_ORIGINS="https://your-frontend.vercel.app"

# Frontend (apps/web)
VITE_API_URL="https://your-backend.vercel.app"
